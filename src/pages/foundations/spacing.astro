---
// Foundations › Spacing: space on a 4px grid, corners, control heights, the three densities, the
// window size classes and fixed component widths, ported from qeetrix-story.
import { ArrowUpRightIcon } from "@qeetrix/icons/icons/arrow-up-right";
import { Logo } from "@/platform/components/Logo";
import CodeFrame from "@/platform/docs/CodeFrame.astro";
import Masthead from "@/platform/docs/Masthead.astro";
import NextPage from "@/platform/docs/NextPage.astro";
import { docs } from "@/qeetrix/docs/chrome";
import DocsPage from "@/qeetrix/docs/DocsPage.astro";
import DensitySwitch from "@/qeetrix/foundations/DensitySwitch";
import Sections from "@/qeetrix/foundations/Sections.astro";
import { sections } from "@/qeetrix/foundations/Spacing";
import { tokens } from "@/qeetrix/foundations/tokens";
import "@/qeetrix/foundations/spacing.css";
import { packages } from "@/qeetrix/packages";
import { links } from "@/qeetrix/site";

const toc = [...sections.map((s) => ({ id: s.id, label: s.name })), { id: "in-code", label: "In code" }];
const css = `.invite-card {
  padding: var(--qx-space-inset-lg);
  display: grid;
  gap: var(--qx-space-form-gap);
}

.invite-actions {
  display: flex;
  gap: var(--qx-space-gap-sm);
}`;
const tsx = `import { Button, Stack, TextField } from "@qeetrix/react";

export function Invite() {
  return (
    <div data-qx-density="compact">
      <Stack gap="lg">
        <TextField label="Work email" />
        <TextField label="Display name" />
      </Stack>
      <Button>Invite</Button>
    </div>
  );
}`;
---

<DocsPage title="Spacing" description="Space on a 4px grid, near-square corners, control heights, three densities, the window size classes and fixed component widths." current="foundations-spacing" section={links.foundations} toc={toc}>
  <Masthead slot="masthead" title="Spacing" lede="Space on a 4px grid, near-square corners and three densities." place={["Docs", "Foundations", "03 of 05"]} source={docs.source("foundations/spacing.astro")}>
    <Fragment slot="aside">
      <dl class="doc-mast-pkgs">
        <div><dt><code>{packages.tokens.name}</code></dt><dd>{packages.tokens.version}</dd></div>
      </dl>
      <p class="doc-mast-links">
        <a href={links.tokensRepo}><Logo name="github-mono" />GitHub<ArrowUpRightIcon size={14} /></a>
        <a href={links.tokensNpm}><Logo name="npm" />npm<ArrowUpRightIcon size={14} /></a>
      </p>
    </Fragment>
    <dl slot="strip" class="doc-mast-strip">
      <div><dt>Grid</dt><dd>4px<span>Every space a multiple</span></dd></div>
      <div><dt>Space steps</dt><dd>{tokens.spaceSteps}<span>From 4px to 64px</span></dd></div>
      <div><dt>Densities</dt><dd>{tokens.densities}<span>Compact to comfortable</span></dd></div>
      <div><dt>Size classes</dt><dd>{tokens.sizeClasses}<span>Compact to extra large</span></dd></div>
    </dl>
  </Masthead>

  <DensitySwitch />
  <div class="qf-scope" data-qx-density="default" data-qf-density="default">
    <Sections sections={sections} />
  </div>

  <section id="in-code" class="doc-sec" aria-labelledby="in-code-title">
    <p class="doc-eyebrow">{String(sections.length + 1).padStart(2, "0")}</p>
    <h2 class="doc-h2" id="in-code-title">In code</h2>
    <p class="qf-lede">Space is a token, never a number. A density set on a container reaches everything inside it.</p>
    <CodeFrame file="invite.css" lang="css" code={css} />
    <CodeFrame file="invite.tsx" code={tsx} />
  </section>

  <NextPage href={links.elevation} label="Next — 04 of 05" title="Elevation" />
</DocsPage>

<script>
  import "@/qeetrix/foundations/ruler";
  import "@/qeetrix/foundations/density";
</script>
