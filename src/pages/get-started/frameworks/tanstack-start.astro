---
// Get started › Frameworks › TanStack Start: Qeetrix as the Qeet consoles set it up: the styles,
// the root route with the colour scheme before paint, and the console frame in a layout route.
import CodeFrame from "@/platform/docs/CodeFrame.astro";
import Masthead from "@/platform/docs/Masthead.astro";
import NextPage from "@/platform/docs/NextPage.astro";
import { docs } from "@/qeetrix/docs/chrome";
import DocsPage from "@/qeetrix/docs/DocsPage.astro";
import { PmChoice, PmCommand } from "@/qeetrix/docs/PackageManager";
import { install } from "@/qeetrix/install";
import { links } from "@/qeetrix/site";

const toc = [
  { id: "install", label: "Install" },
  { id: "styles", label: "Styles" },
  { id: "root", label: "The root route" },
  { id: "frame", label: "The console frame" },
];
const css = install.css.join("\n");
const root = `import { colorSchemeScript, QeetrixProvider, ToastProvider } from "@qeetrix/react";
import { createRootRoute, HeadContent, ScriptOnce, Scripts } from "@tanstack/react-router";
import type { ReactNode } from "react";
import appCss from "../styles.css?url";

export const Route = createRootRoute({
  head: () => ({
    meta: [{ charSet: "utf-8" }, { name: "viewport", content: "width=device-width, initial-scale=1" }],
    links: [{ rel: "stylesheet", href: appCss }],
  }),
  shellComponent: RootDocument,
});

function RootDocument({ children }: { children: ReactNode }) {
  return (
    <html lang="en-IN" suppressHydrationWarning>
      <head>
        {/* The saved scheme, or the system's, on <html> before the first paint. */}
        <ScriptOnce>{colorSchemeScript()}</ScriptOnce>
        <HeadContent />
      </head>
      <body>
        <QeetrixProvider locale="en-IN" defaultColorScheme="system" storageKey="qx-color-scheme">
          <ToastProvider>{children}</ToastProvider>
        </QeetrixProvider>
        <Scripts />
      </body>
    </html>
  );
}`;
const app = `import { AppShell } from "@qeetrix/react/experimental";
import { createFileRoute, Outlet } from "@tanstack/react-router";
import { ConsoleSidebar } from "../shell/sidebar";
import { ConsoleTopBar } from "../shell/top-bar";

// The frame mounts once, around every page: routes change only what's inside it.
export const Route = createFileRoute("/_app")({
  component: () => (
    <AppShell topBar={<ConsoleTopBar />} sidebar={<ConsoleSidebar />}>
      <Outlet />
    </AppShell>
  ),
});`;
const users = `import { PageContent, PageHeader } from "@qeetrix/react/experimental";
import { createFileRoute } from "@tanstack/react-router";

export const Route = createFileRoute("/_app/users")({
  component: () => (
    <>
      <PageHeader title="Users" count={1284} />
      <PageContent>…</PageContent>
    </>
  ),
});`;
---

<DocsPage title="TanStack Start" description="Set up Qeetrix in a TanStack Start app, as the Qeet consoles do: the styles, the root route and the console frame." current="tanstack-start" section={links.docs} toc={toc}>
  <Masthead slot="masthead" title="TanStack Start" lede="Qeetrix as the Qeet consoles set it up, with the console frame around every route." place={["Docs", "Get started", "Frameworks", "TanStack Start"]} source={docs.source("get-started/frameworks/tanstack-start.astro")}>
    <dl slot="strip" class="doc-mast-strip">
      <div><dt>Time</dt><dd>5 minutes<span>Three files</span></dd></div>
      <div><dt>Requires</dt><dd>TanStack Start 1<span>Vite 8, React 19.2</span></dd></div>
      <div><dt>Package manager</dt><dd><PmChoice client:load /></dd></div>
    </dl>
  </Masthead>

  <section id="install" class="doc-sec" aria-labelledby="install-title">
    <p class="doc-eyebrow">01 — Install</p>
    <h2 class="doc-h2" id="install-title">The packages.</h2>
    <PmCommand client:load packages={install.packages} peer="@base-ui/react" />
  </section>

  <section id="styles" class="doc-sec" aria-labelledby="styles-title">
    <p class="doc-eyebrow">02 — Styles</p>
    <h2 class="doc-h2" id="styles-title">Plain CSS, linked by the route.</h2>
    <p class="doc-p">No Vite plugin: Vite resolves the imports. The root route links the compiled file through <code>?url</code>.</p>
    <CodeFrame file="src/styles.css" lang="css" code={css} />
  </section>

  <section id="root" class="doc-sec" aria-labelledby="root-title">
    <p class="doc-eyebrow">03 — The root route</p>
    <h2 class="doc-h2" id="root-title">The scheme before the first paint.</h2>
    <p class="doc-p"><code>ScriptOnce</code> runs while the head parses, with the request's CSP nonce, and removes itself. QeetrixProvider then takes over; it's yours to keep the choice, here in local storage.</p>
    <CodeFrame file="src/routes/__root.tsx" code={root} />
  </section>

  <section id="frame" class="doc-sec" aria-labelledby="frame-title">
    <p class="doc-eyebrow">04 — The console frame</p>
    <h2 class="doc-h2" id="frame-title">One AppShell, in a layout route.</h2>
    <p class="doc-p">The shell mounts once; each page brings its PageHeader and PageContent. See <a href={`${links.components}/app-shell/`}>App shell</a> for the top bar and the sidebar.</p>
    <div class="doc-step-panel">
      <CodeFrame file="src/routes/_app.tsx" code={app} />
      <CodeFrame file="src/routes/_app/users.tsx" code={users} />
    </div>
  </section>

  <NextPage href={links.vite} label="Next — Frameworks" title="Vite" />
</DocsPage>
