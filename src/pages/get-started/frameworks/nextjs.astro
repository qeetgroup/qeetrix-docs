---
// Get started › Frameworks › Next.js: Qeetrix in an App Router app: the packages, the styles, the
// providers, the colour scheme before paint, and what renders on the server.
import CodeFrame from "@/platform/docs/CodeFrame.astro";
import Masthead from "@/platform/docs/Masthead.astro";
import NextPage from "@/platform/docs/NextPage.astro";
import { docs } from "@/qeetrix/docs/chrome";
import DocsPage from "@/qeetrix/docs/DocsPage.astro";
import { PmChoice, PmCommand } from "@/qeetrix/docs/PackageManager";
import { SERVER_SAFE } from "@/qeetrix/guides";
import { install } from "@/qeetrix/install";
import { links } from "@/qeetrix/site";

const toc = [
  { id: "install", label: "Install" },
  { id: "styles", label: "Styles" },
  { id: "providers", label: "Providers" },
  { id: "layout", label: "The root layout" },
  { id: "server", label: "Server components" },
];
const css = install.css.join("\n");
const providers = `"use client";

import { QeetrixProvider, ToastProvider } from "@qeetrix/react";
import type { ReactNode } from "react";

export function Providers({ children }: { children: ReactNode }) {
  return (
    <QeetrixProvider locale="en-IN" defaultColorScheme="system" storageKey="qx-color-scheme">
      <ToastProvider>{children}</ToastProvider>
    </QeetrixProvider>
  );
}`;
const layout = `import { colorSchemeScript } from "@qeetrix/react";
import type { ReactNode } from "react";
import { Providers } from "./providers";
import "./globals.css";

export default function RootLayout({ children }: { children: ReactNode }) {
  return (
    <html lang="en-IN" suppressHydrationWarning>
      <head>
        <script dangerouslySetInnerHTML={{ __html: colorSchemeScript() }} />
      </head>
      <body>
        <Providers>{children}</Providers>
      </body>
    </html>
  );
}`;
const page = `import { Badge, Card, Text } from "@qeetrix/react";
import { InviteButton } from "./invite-button";

// A Server Component: Card, Badge and Text render here, with no JavaScript.
export default function Page() {
  return (
    <Card title="Users" level={2} actions={<InviteButton />}>
      <Text>1,284 users</Text> <Badge tone="success">Synced</Badge>
    </Card>
  );
}`;
const invite = `"use client";

import { PlusIcon } from "@qeetrix/icons";
import { Button, useToast } from "@qeetrix/react";

// Your own handler needs a client component; Button itself is one already.
export function InviteButton() {
  const toast = useToast();
  return <Button icon={PlusIcon} onClick={() => toast.add({ title: "Invitation sent", tone: "success" })}>Invite users</Button>;
}`;
---

<DocsPage title="Next.js" description="Set up Qeetrix in a Next.js App Router app: the packages, the styles, the providers and the colour scheme before paint." current="nextjs" section={links.docs} toc={toc}>
  <Masthead slot="masthead" title="Next.js" lede="Qeetrix in an App Router app, with the colour scheme right on the first paint." place={["Docs", "Get started", "Frameworks", "Next.js"]} source={docs.source("get-started/frameworks/nextjs.astro")}>
    <dl slot="strip" class="doc-mast-strip">
      <div><dt>Time</dt><dd>5 minutes<span>Four files</span></dd></div>
      <div><dt>Requires</dt><dd>Next.js 16<span>React 19.2, App Router</span></dd></div>
      <div><dt>Package manager</dt><dd><PmChoice client:load /></dd></div>
    </dl>
  </Masthead>

  <section id="install" class="doc-sec" aria-labelledby="install-title">
    <p class="doc-eyebrow">01 — Install</p>
    <h2 class="doc-h2" id="install-title">The packages.</h2>
    <PmCommand client:load packages={install.packages} peer="@base-ui/react" />
  </section>

  <section id="styles" class="doc-sec" aria-labelledby="styles-title">
    <p class="doc-eyebrow">02 — Styles</p>
    <h2 class="doc-h2" id="styles-title">The tokens, then the components.</h2>
    <p class="doc-p">No PostCSS plugin and no Tailwind: plain CSS imports, in their layers.</p>
    <CodeFrame file="app/globals.css" lang="css" code={css} />
  </section>

  <section id="providers" class="doc-sec" aria-labelledby="providers-title">
    <p class="doc-eyebrow">03 — Providers</p>
    <h2 class="doc-h2" id="providers-title">One client component for the providers.</h2>
    <p class="doc-p">QeetrixProvider holds the locale and the colour scheme; storageKey saves the choice where the script reads it.</p>
    <CodeFrame file="app/providers.tsx" code={providers} />
  </section>

  <section id="layout" class="doc-sec" aria-labelledby="layout-title">
    <p class="doc-eyebrow">04 — The root layout</p>
    <h2 class="doc-h2" id="layout-title">The scheme before the first paint.</h2>
    <p class="doc-p">colorSchemeScript sets the saved scheme on <code>&lt;html&gt;</code> before the first paint, a fixed string a strict CSP can allow by its hash. It changes <code>&lt;html&gt;</code> before React runs, so <code>suppressHydrationWarning</code> says that's expected.</p>
    <CodeFrame file="app/layout.tsx" code={layout} />
  </section>

  <section id="server" class="doc-sec" aria-labelledby="server-title">
    <p class="doc-eyebrow">05 — Server components</p>
    <h2 class="doc-h2" id="server-title">Most render on the server.</h2>
    <p class="doc-p">Interactive components carry their own <code>"use client"</code>, so a Server Component renders them as they are. These ship no JavaScript at all:</p>
    <p class="doc-p">{SERVER_SAFE.map((name, i) => <Fragment>{i > 0 && ", "}<code>{name}</code></Fragment>)}.</p>
    <div class="doc-step-panel">
      <CodeFrame file="app/users/page.tsx" code={page} />
      <CodeFrame file="app/users/invite-button.tsx" code={invite} />
    </div>
  </section>

  <NextPage href={links.tanstackStart} label="Next — Frameworks" title="TanStack Start" />
</DocsPage>
