        {slug === "popover" && <PopoverPlayground slot="playground" client:visible />}
        {slug === "popover" && examples.map((example) => <PopoverLive slot={example.id} id={example.id} client:visible />)}
        {slug === "tooltip" && <TooltipPlayground slot="playground" client:visible />}
        {slug === "tooltip" && examples.map((example) => <TooltipLive slot={example.id} id={example.id} client:visible />)}
        {slug === "menu" && <MenuPlayground slot="playground" client:visible />}
        {slug === "menu" && examples.map((example) => <MenuLive slot={example.id} id={example.id} client:visible />)}
        {slug === "context-menu" && examples.map((example) => <ContextMenuLive slot={example.id} id={example.id} client:visible />)}
        {slug === "toast" && <ToastPlayground slot="playground" client:visible />}
        {slug === "toast" && examples.map((example) => <ToastLive slot={example.id} id={example.id} client:visible />)}
        {slug === "tabs" && <TabsPlayground slot="playground" client:visible />}
        {slug === "tabs" && examples.map((example) => <TabsLive slot={example.id} id={example.id} client:visible />)}
        {slug === "accordion" && <AccordionPlayground slot="playground" client:visible />}
        {slug === "accordion" && examples.map((example) => <AccordionLive slot={example.id} id={example.id} client:visible />)}
        {slug === "collapsible" && <CollapsiblePlayground slot="playground" client:visible />}
        {slug === "collapsible" && examples.map((example) => <CollapsibleLive slot={example.id} id={example.id} client:visible />)}
        {slug === "breadcrumb" && <BreadcrumbPlayground slot="playground" client:visible />}
