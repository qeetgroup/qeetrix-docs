        {slug === "otp-input" && <OtpInputPlayground slot="playground" client:visible />}
        {slug === "otp-input" && examples.map((example) => <OtpInputLive slot={example.id} id={example.id} client:visible />)}
        {slug === "file-upload" && examples.map((example) => <FileUploadLive slot={example.id} id={example.id} client:visible />)}
        {slug === "form" && examples.map((example) => <FormLive slot={example.id} id={example.id} client:visible />)}
        {slug === "calendar" && <CalendarPlayground slot="playground" client:visible />}
        {slug === "calendar" && examples.map((example) => <CalendarLive slot={example.id} id={example.id} client:visible />)}
        {slug === "range-calendar" && <RangeCalendarPlayground slot="playground" client:visible />}
        {slug === "range-calendar" && examples.map((example) => <RangeCalendarLive slot={example.id} id={example.id} client:visible />)}
        {slug === "date-picker" && <DatePickerPlayground slot="playground" client:visible />}
        {slug === "date-picker" && examples.map((example) => <DatePickerLive slot={example.id} id={example.id} client:visible />)}
        {slug === "date-range-picker" && <DateRangePickerPlayground slot="playground" client:visible />}
