import TreeViewLive from "@/qeetrix/components/tree-view/Live";
import TreeViewPlayground from "@/qeetrix/components/tree-view/Playground";
import { type ComponentDoc, TABS, type Tab } from "@/qeetrix/components/types";

export function getStaticPaths() {
  return DOCS.flatMap((doc) => TABS.map((tab) => ({ params: { component: doc.slug, tab: tab.path || undefined }, props: { doc, tab: tab.id } })));
}

const { doc, tab } = Astro.props as { doc: ComponentDoc; tab: Tab };
const { slug, examples } = doc;
---

<ComponentPage doc={doc} tab={tab} playground={PLAYGROUNDS.has(slug)}>
  {
    tab === "examples" && (
      <Examples doc={doc} playground={PLAYGROUNDS.has(slug)} live={LIVE.has(slug)}>
        {slug === "button" && <ButtonPlayground slot="playground" client:visible />}
        {slug === "icon-button" && <IconButtonPlayground slot="playground" client:visible />}
        {slug === "icon-button" && examples.map((example) => <IconButtonLive slot={example.id} id={example.id} client:visible />)}
        {slug === "toggle" && <TogglePlayground slot="playground" client:visible />}
        {slug === "toggle" && examples.map((example) => <ToggleLive slot={example.id} id={example.id} client:visible />)}
        {slug === "toggle-group" && <ToggleGroupPlayground slot="playground" client:visible />}
        {slug === "toggle-group" && examples.map((example) => <ToggleGroupLive slot={example.id} id={example.id} client:visible />)}
        {slug === "copy-button" && <CopyButtonPlayground slot="playground" client:visible />}
        {slug === "copy-button" && examples.map((example) => <CopyButtonLive slot={example.id} id={example.id} client:visible />)}
        {slug === "command-palette" && examples.map((example) => <CommandPaletteLive slot={example.id} id={example.id} client:visible />)}
        {slug === "text-field" && <TextFieldPlayground slot="playground" client:visible />}
        {slug === "text-field" && examples.map((example) => <TextFieldLive slot={example.id} id={example.id} client:visible />)}
        {slug === "input" && <InputPlayground slot="playground" client:visible />}
        {slug === "input" && examples.map((example) => <InputLive slot={example.id} id={example.id} client:visible />)}
        {slug === "textarea" && <TextareaPlayground slot="playground" client:visible />}
        {slug === "textarea" && examples.map((example) => <TextareaLive slot={example.id} id={example.id} client:visible />)}
        {slug === "select" && <SelectPlayground slot="playground" client:visible />}
        {slug === "select" && examples.map((example) => <SelectLive slot={example.id} id={example.id} client:visible />)}
        {slug === "combobox" && <ComboboxPlayground slot="playground" client:visible />}
        {slug === "combobox" && examples.map((example) => <ComboboxLive slot={example.id} id={example.id} client:visible />)}
        {slug === "checkbox" && <CheckboxPlayground slot="playground" client:visible />}
        {slug === "checkbox" && examples.map((example) => <CheckboxLive slot={example.id} id={example.id} client:visible />)}
        {slug === "radio" && <RadioPlayground slot="playground" client:visible />}
        {slug === "radio" && examples.map((example) => <RadioLive slot={example.id} id={example.id} client:visible />)}
        {slug === "switch" && <SwitchPlayground slot="playground" client:visible />}
        {slug === "switch" && examples.map((example) => <SwitchLive slot={example.id} id={example.id} client:visible />)}
        {slug === "slider" && <SliderPlayground slot="playground" client:visible />}
        {slug === "slider" && examples.map((example) => <SliderLive slot={example.id} id={example.id} client:visible />)}
        {slug === "number-field" && <NumberFieldPlayground slot="playground" client:visible />}
