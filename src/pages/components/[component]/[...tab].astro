        {slug === "meter" && <MeterPlayground slot="playground" client:visible />}
        {slug === "spinner" && <SpinnerPlayground slot="playground" client:visible />}
        {slug === "empty-state" && <EmptyStatePlayground slot="playground" client:visible />}
        {slug === "empty-state" && examples.map((example) => <EmptyStateLive slot={example.id} id={example.id} client:visible />)}
