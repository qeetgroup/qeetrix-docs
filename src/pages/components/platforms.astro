---
// Components › Platforms: every component page with its counterparts in Qeetrix for iOS and for
// Android, by category; then the native components no page covers. All of it from the native
// libraries' own lists (native-components.ts), so a native release changes it with `bun run native`.
import { MinusIcon } from "@qeetrix/icons/icons/minus";
import { Logo } from "@/platform/components/Logo";
import Masthead from "@/platform/docs/Masthead.astro";
import { leftOutOnAndroid, type NativeComponent, nativeOf, nativeOnly } from "@/qeetrix/components/platforms";
import { DOCS } from "@/qeetrix/components/registry";
import { seams } from "@/qeetrix/components/seams";
import { docs } from "@/qeetrix/docs/chrome";
import { categories, componentHref, slug } from "@/qeetrix/docs/components";
import DocsPage from "@/qeetrix/docs/DocsPage.astro";
import { nativeLibraries, packages } from "@/qeetrix/packages";
import { links } from "@/qeetrix/site";

const toc = [
  { id: "components", label: "Every component" },
  { id: "native", label: "Native components" },
] as const;
const rows = categories.map((c) => ({
  ...c,
  items: c.items.map((item) => ({ name: item.name, href: componentHref(item.name), ...nativeOf(slug(item.name)) })),
}));
const covered = (platform: "ios" | "android") => DOCS.filter((d) => nativeOf(d.slug)[platform].length > 0).length;
const names = (list: NativeComponent[]) => list.map((c) => c.api[0]).join(", ");
---

<DocsPage title="Platforms" description="Every Qeetrix component on the web, iOS and Android, by each library's own name, and the native components the web doesn't have." current="components-platforms" section={links.components} toc={[...toc]}>
  <Masthead slot="masthead" title="Platforms" lede="Every component on the web, iOS and Android, by each library's own name." place={["Docs", "Components", "Updated 13 Nov 2026"]} source={docs.source("components/platforms.astro")}>
    <dl slot="strip" class="doc-mast-strip">
      <div><dt>Web</dt><dd>{DOCS.length}<span>Component pages, {packages.react.name} {packages.react.version}</span></dd></div>
      <div><dt><span class="doc-brand-case">iOS</span></dt><dd>{covered("ios")}<span>Of them in Qeetrix for iOS {nativeLibraries.ios.version}</span></dd></div>
      <div><dt>Android</dt><dd>{covered("android")}<span>Of them in Qeetrix for Android {nativeLibraries.android.version}</span></dd></div>
      <div><dt>Native</dt><dd>{nativeOnly.length}<span>Components with no page here</span></dd></div>
    </dl>
  </Masthead>

  <section id="components" class="doc-sec" aria-labelledby="components-title">
    <p class="doc-eyebrow">01 — Every component</p>
    <h2 class="doc-h2" id="components-title">One component, three names.</h2>
    <p class="doc-p">Each page's Usage tab has the rest: every native counterpart, and what to import on each platform. Set up <a href={links.ios}>iOS</a> or <a href={links.android}>Android</a>.</p>
    <div class="doc-table-scroll">
      <table class="doc-table doc-table-names doc-table-platforms">
        <thead>
          <tr>
            <th scope="col">Component</th>
            <th scope="col"><span class="qd-browser"><Logo name="apple-mono" />iOS</span></th>
            <th scope="col"><span class="qd-browser"><Logo name="android" />Android</span></th>
          </tr>
        </thead>
        {
          rows.map((c) => (
            <tbody>
              <tr class="qd-platforms-group"><th scope="colgroup" colspan="3">{c.name}</th></tr>
              {c.items.map((item) => (
                <tr>
                  <th scope="row"><a href={item.href}>{item.name}</a></th>
                  <td>{item.ios.length ? <code set:html={seams(names(item.ios))} /> : <span class="doc-no"><MinusIcon size={16} />None</span>}</td>
                  <td>
                    {item.android.length ? (
                      <code set:html={seams(names(item.android))} />
                    ) : (
                      <span class="doc-no"><MinusIcon size={16} />{leftOutOnAndroid(item.name) ? "Left out, by decision" : "None"}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
  </section>

  <section id="native" class="doc-sec" aria-labelledby="native-title">
    <p class="doc-eyebrow">02 — Native components</p>
    <h2 class="doc-h2" id="native-title">What only the apps need, or has no page yet.</h2>
    <p class="doc-p">Components the native libraries have that no page here covers, with the {packages.react.name} counterpart where their lists name one.</p>
    <div class="doc-table-scroll">
      <table class="doc-table doc-table-names doc-table-platforms">
        <thead>
          <tr>
            <th scope="col">Component</th>
            <th scope="col"><span class="qd-browser"><Logo name="react-light" className="only-light" /><Logo name="react-dark" className="only-dark" />Web</span></th>
            <th scope="col"><span class="qd-browser"><Logo name="apple-mono" />iOS</span></th>
            <th scope="col"><span class="qd-browser"><Logo name="android" />Android</span></th>
          </tr>
        </thead>
        <tbody>
          {
            nativeOnly.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                <td>{r.web.length ? <code set:html={seams(r.web.join(", "))} /> : <span class="doc-no"><MinusIcon size={16} />None</span>}</td>
                <td>{r.ios ? <code set:html={seams(r.ios.api[0] ?? "")} /> : <span class="doc-no"><MinusIcon size={16} />None</span>}</td>
                <td>{r.android ? <code set:html={seams(r.android.api[0] ?? "")} /> : <span class="doc-no"><MinusIcon size={16} />None</span>}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</DocsPage>
