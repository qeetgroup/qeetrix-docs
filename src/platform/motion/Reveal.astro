---
// Reveal motion for landing pages: each [data-reveal] block rises in once as it scrolls into view,
// staggered by data-reveal-delay (milliseconds). Put this first in <body>. It marks <html> with
// data-motion before anything paints, so without the script (or with reduced motion) every block
// simply renders in place. Reading pages don't include it, and so ship no script for it.
import "./reveal.css";
---

<script is:inline>document.documentElement.setAttribute("data-motion", "");</script>
<script>
  const seen = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        el.style.setProperty("--reveal-delay", el.dataset.revealDelay ?? "0");
        el.classList.add("is-in");
        seen.unobserve(el);
      }
    },
    { threshold: 0.12, rootMargin: "0px 0px -24px 0px" },
  );
  for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
</script>
