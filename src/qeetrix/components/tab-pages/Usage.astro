---
// A component's Usage tab: when to use it and what instead, its anatomy (the real component, its
// parts numbered by anatomy.ts), its do-and-don'ts drawn with the real components, its sizes,
// its words, its names on iOS and Android, and the components near it.
import { ArrowRightIcon } from "@qeetrix/icons/icons/arrow-right";
import { CircleCheckIcon } from "@qeetrix/icons/icons/circle-check";
import { CircleXIcon } from "@qeetrix/icons/icons/circle-x";
import { Badge } from "@qeetrix/react";
import { Logo } from "@/platform/components/Logo";
import { ComponentSpecimen } from "@/qeetrix/docs/ComponentSpecimens";
import { categories, componentHref } from "@/qeetrix/docs/components";
import "@/qeetrix/icons/rules.css";
import { nativeLibraries } from "@/qeetrix/packages";
import { links } from "@/qeetrix/site";
import Node from "../Node";
import { leftOutOnAndroid, type NativeComponent, nativeOf } from "../platforms";
import Sec from "../Sec.astro";
import { seams } from "../seams";
import { moduleOf, numberOf, sectionsOf } from "../sections";
import type { ComponentDoc } from "../types";

interface Props {
  doc: ComponentDoc;
}

const { doc } = Astro.props;
const { usage } = doc;
const sections = sectionsOf(doc, "usage");
const n = (id: string) => numberOf(sections, id);
const entry = (name: string) => categories.flatMap((category) => category.items).find((item) => item.name === name);
// Its counterparts in the native libraries' own lists: the native name where it differs from the page's.
const native = nativeOf(doc.slug);
const named = (c: NativeComponent) => (c.name.toLowerCase() === doc.name.toLowerCase() ? "" : c.name);
const platforms = [
  {
    logo: "apple-mono",
    label: "iOS",
    href: links.ios,
    rows: native.ios.map((c) => ({ name: named(c), api: c.api, from: "Qeetrix" })),
    none: "Not in Qeetrix for iOS",
  },
  {
    logo: "android",
    label: "Android",
    href: links.android,
    rows: native.android.map((c) => ({
      name: named(c),
      api: c.api,
      from: `com.qeetgroup.qeetrix.components.${c.package}`,
    })),
    none: leftOutOnAndroid(doc.name) ? "Left out of Qeetrix for Android, by decision" : "Not in Qeetrix for Android",
  },
] as const;
---

<Sec id="when-to-use" n={n("when-to-use")} title="When to use">
  <div class="qc-fit">
    <div class="qc-fit-col" data-kind="do">
      <b class="qc-fit-head"><CircleCheckIcon size={16} aria-hidden />Use it for</b>
      <ul>{usage.useFor.map((line) => <li>{line}</li>)}</ul>
    </div>
    <div class="qc-fit-col" data-kind="dont">
      <b class="qc-fit-head"><CircleXIcon size={16} aria-hidden />Not for</b>
      <ul>
        {
          usage.notFor.map((item) => (
            <li>
              {item.text}
              <a class="qc-fit-use" href={componentHref(item.use)}>
                {item.use}
                <ArrowRightIcon size={14} data-qx-mirror aria-hidden />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Sec>

<Sec id="anatomy" n={n("anatomy")} title="Anatomy">
  <div class="qc-anat" data-qc-anat={JSON.stringify(usage.anatomy.map((part) => part.select ?? `[data-slot="${part.slot}"]`))}>
    <div class="qc-anat-stage">
      <div class="qc-anat-figure" aria-hidden="true" inert><Node node={usage.anatomyFigure} /></div>
      <ol class="qc-anat-marks" aria-hidden="true" data-qc-anat-marks></ol>
    </div>
    <ol class="qc-anat-key">
      {
        usage.anatomy.map((part, index) => (
          <li>
            <span class="qc-anat-n">{index + 1}</span>
            <code>{part.slot}</code>
            <span class="qc-anat-element">{part.element}</span>
            <span class="qc-anat-note">{part.note}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Sec>

<Sec id="do-and-dont" n={n("do-and-dont")} title="Do and don't">
  <div class="qf-rules">
    {
      usage.rules.map((rule) => (
        <div class="qf-rule">
          <b class="qf-rule-title">{rule.title}</b>
          <div class="qf-rule-pair">
            {(["do", "dont"] as const).map((kind) => (
              <figure class="qf-rule-case" data-kind={kind}>
                <div class="qf-rule-stage" aria-hidden="true" inert>
                  <Node node={kind === "do" ? rule.doIt : rule.dontIt} />
                </div>
                <figcaption>
                  <span class="qf-rule-verdict">
                    {kind === "do" ? <CircleCheckIcon size={16} aria-hidden /> : <CircleXIcon size={16} aria-hidden />}
                    {kind === "do" ? "Do" : "Don't"}
                  </span>
                  <span>{kind === "do" ? rule.doLine : rule.dontLine}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Sec>

{
  usage.sizes && (
    <Sec id="sizes" n={n("sizes")} title="Sizes" line={usage.sizes.line ?? "Each height follows the region's density."}>
      <div class="qc-sizes-stage" aria-hidden="true" inert>
        <Node node={usage.sizes.specimen} />
      </div>
      <div class="doc-table-scroll">
        <table class="doc-table">
          <thead>
            <tr>{usage.sizes.columns.map((column) => <th scope="col">{column}</th>)}</tr>
          </thead>
          <tbody>
            {usage.sizes.rows.map(([size, ...cells]) => (
              <tr><th scope="row"><code>{size}</code></th>{cells.map((cell) => <td>{/^[a-z]+\.[a-z]+$/.test(cell) ? <code>{cell}</code> : cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </Sec>
  )
}

<Sec id="content" n={n("content")} title="Content">
  <ul class="qc-list">{usage.content.map((line) => <li>{line}</li>)}</ul>
</Sec>

<Sec id="platforms" n={n("platforms")} title="Platforms" line={`The same tokens and the same look in Qeetrix for iOS ${nativeLibraries.ios.version} and for Android ${nativeLibraries.android.version}, by each library's own names.`}>
  <div class="doc-table-scroll">
    <table class="doc-table doc-table-names">
      <thead><tr><th scope="col">Platform</th><th scope="col">Name</th><th scope="col">Import</th></tr></thead>
      <tbody>
        <tr>
          <th scope="row"><span class="qd-browser"><Logo name="react-light" className="only-light" /><Logo name="react-dark" className="only-dark" />Web</span></th>
          <td><code set:html={seams(doc.exports.join(", "))} /></td>
          <td><code>{moduleOf(doc)}</code></td>
        </tr>
        {
          platforms.map((p) =>
            p.rows.length ? (
              p.rows.map((r, i) => (
                <tr>
                  <th scope="row">{i === 0 && <a class="qd-browser" href={p.href}><Logo name={p.logo} />{p.label}</a>}</th>
                  <td>{r.name && <>{r.name}: </>}<code set:html={seams(r.api.join(", "))} /></td>
                  <td><code set:html={seams(r.from)} /></td>
                </tr>
              ))
            ) : (
              <tr>
                <th scope="row"><a class="qd-browser" href={p.href}><Logo name={p.logo} />{p.label}</a></th>
                <td colspan="2">{p.none}</td>
              </tr>
            ),
          )
        }
      </tbody>
    </table>
  </div>
</Sec>

<Sec id="related" n={n("related")} title="Related">
  <ul class="doc-cards">
    {
      doc.related.map((item) => {
        const known = entry(item.name);
        return (
          <li class="doc-card">
            <ComponentSpecimen name={item.name} />
            <div class="doc-card-copy">
              <span class="doc-card-title">
                <a class="doc-card-link" href={componentHref(item.name)}>{item.name}</a>
                <ArrowRightIcon size={16} className="doc-card-arrow" data-qx-mirror />
              </span>
              <span class="doc-card-meta">
                <span class="doc-card-line">{item.when}</span>
                {known?.exp ? <Badge tone="warning" size="sm">Experimental</Badge> : <Badge tone="success" size="sm">Stable</Badge>}
              </span>
            </div>
          </li>
        );
      })
    }
  </ul>
</Sec>

<script>
  import "../anatomy";
</script>
