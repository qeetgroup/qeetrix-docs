# qeetrix-docs (ui.qeet.in) — environment variables
#
# This site is a static-first Next.js app. No server secrets are required:
# the MCP, registry (/r), llms.txt/llms-full.txt, and telemetry endpoints all
# run without credentials. Copy this file to `.env.local` to override defaults.

# Privacy-first analytics (Plausible). Set to the site domain to enable the
# analytics script; leave empty (or unset) to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ui.qeet.in
