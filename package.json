{
  "name": "qeetrix-docs",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "ui.qeet.in: the Qeetrix docs, on Qeet's own docs platform (Astro and @qeetrix/react).",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "astro dev --port 3007",
    "build": "astro build",
    "preview": "astro preview --port 3007",
    "types:check": "astro sync && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "components": "bun scripts/components.ts && biome check --write src/qeetrix/components/registry.ts \"src/pages/components/[component]/[...tab].astro\""
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@base-ui/react": "^1.9.0",
    "@qeetrix/icons": "^2.0.0",
    "@qeetrix/react": "0.2.2",
    "@qeetrix/tokens": "^0.0.10",
    "astro": "7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
