{
  "name": "qeetrix-docs",
  "version": "0.2.3",
  "private": true,
  "description": "ui.qeet.in — the Qeetrix design system documentation & developer platform.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "node scripts/generate-components.mjs && node scripts/generate-tokens.mjs && node scripts/generate-icons.mjs && next build",
    "dev": "node scripts/generate-components.mjs && node scripts/generate-tokens.mjs && node scripts/generate-icons.mjs && next dev -p 3006",
    "start": "next start -p 3006",
    "generate:components": "node scripts/generate-components.mjs",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "types:check": "node scripts/generate-components.mjs && node scripts/generate-tokens.mjs && next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@qeetrix/icons": "^1.0.12",
    "@qeetrix/react": "^0.1.1",
    "@qeetrix/tokens": "^0.0.9",
    "@qeetrix/ui": "2.1.4",
    "@thesvg/react": "^3.3.12",
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
